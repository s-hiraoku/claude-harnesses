{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s-hiraoku/claude-harnesses/schemas/plugin.schema.json",
  "title": "Claude Code plugin manifest",
  "description": "Schema for .claude-plugin/plugin.json. Tracks the documented Claude Code plugin shape: skills/agents/commands are auto-discovered from conventional directories at the plugin root; hooks and mcpServers may be declared explicitly. Component paths must stay inside the plugin root so the plugin remains installable from a marketplace.",
  "type": "object",
  "required": ["name", "version", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "homepage": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": { "type": "string" },
    "agents": { "type": "string" },
    "commands": { "type": "string" },
    "hooks": { "type": "string" },
    "mcpServers": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "marketplace": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
