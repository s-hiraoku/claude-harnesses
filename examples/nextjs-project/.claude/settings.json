{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npm run build*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env.local)"
    ]
  }
}
